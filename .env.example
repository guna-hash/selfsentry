# Copy this file to .env and fill in real values. Never commit .env.

# --- Phase 1: Image Scanner ---
# Only needed if scanning images from a private registry.
# TRIVY_USERNAME=
# TRIVY_PASSWORD=

# --- Phase 7: AI Threat Analysis (added later) ---
# OPENAI_API_KEY=

# --- Phase 8: Backend + Database (added later) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/containerguard

# --- Continuous monitor (all optional; defaults are in docs/monitor_service.md) ---
# SELFSENTRY_BACKEND_URL=http://localhost:8000
# FALCO_LOG_PATH=/var/log/falco/alerts.json
# MONITOR_UNAPPROVED_START_POLICY=alert
# MONITOR_REGISTRATION_GRACE_SECONDS=15
# MONITOR_LOG_FORMAT=text

# --- Backend writes: generate a random token; do not use a shared example value ---
# SELFSENTRY_API_TOKEN=

# --- Per-container behavioral learning (the window must match stored baselines) ---
# MONITOR_BASELINE_DIR=behavioral-engine/baselines
# MONITOR_LEARNING_ENABLED=true
# MONITOR_LEARNING_SECONDS=900
# MONITOR_MIN_SAMPLES=20
# MONITOR_WINDOW_SECONDS=60
# MONITOR_LATENESS_SECONDS=10
# MONITOR_ANOMALY_THRESHOLD=0.8
# MONITOR_CORRELATION_SECONDS=60
# MONITOR_RETRAIN_POLICY=manual

# --- Independent automation switches ---
# AUTO_CONFIRM_ENABLED=true
# AUTO_CONFIRM_THRESHOLD=90
# AUTO_ISOLATION_ENABLED=false
# AUTO_ISOLATION_THRESHOLD=90
# MONITOR_PROTECTED_CONTAINERS=postgres,selfsentry-backend
# MONITOR_RESPONSE_MAX_AGE_SECONDS=120
# MONITOR_RULE_CANDIDATES_ENABLED=true
# MONITOR_BENIGN_LOG_PATH=/absolute/path/to/operator-validated-benign-log.jsonl

# --- Optional advisory AI (existing Groq-compatible provider) ---
# GROQ_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
