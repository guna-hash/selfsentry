# Copy this file to .env and fill in real values. Never commit .env.

# --- Phase 1: Image Scanner ---
# Only needed if scanning images from a private registry.
# TRIVY_USERNAME=
# TRIVY_PASSWORD=

# --- Phase 7: AI Threat Analysis (added later) ---
# OPENAI_API_KEY=

# --- Backend database (required for host operation) ---
# Plain PostgreSQL URLs explicitly use the installed psycopg2 driver.
# Connection timeout defaults to 5s; a positive ?connect_timeout=10 overrides it.
# Pool checkout waits up to 5s. These are not SQL/lock/full-request timeouts.
# DATABASE_URL=postgresql://selfsentry:<your-password>@localhost:5432/selfsentry_db

# --- Continuous monitor (all optional; defaults are in docs/monitor_service.md) ---
# SELFSENTRY_BACKEND_URL=http://localhost:8000
# FALCO_LOG_PATH=/var/log/falco/alerts.json
# MONITOR_UNAPPROVED_START_POLICY=alert
# MONITOR_REGISTRATION_GRACE_SECONDS=15
# MONITOR_LOG_FORMAT=text

# --- Backend reads/writes: generate a random token; no shared example value ---
# SELFSENTRY_API_TOKEN=

# --- Per-container behavioral learning (the window must match stored baselines) ---
# MONITOR_BASELINE_DIR=behavioral-engine/baselines
# MONITOR_LEARNING_ENABLED=true
# MONITOR_LEARNING_SECONDS=900
# MONITOR_MIN_SAMPLES=20
# MONITOR_WINDOW_SECONDS=60
# MONITOR_LATENESS_SECONDS=10
# MONITOR_ANOMALY_THRESHOLD=0.8
# MONITOR_CORRELATION_SECONDS=60
# MONITOR_RETRAIN_POLICY=manual

# --- Independent automation switches ---
# Conservative setup examples; commented values do not override code defaults.
# Explicitly set the three switches below to false in a fresh host's private .env.
# AUTO_CONFIRM_ENABLED=false
# AUTO_CONFIRM_THRESHOLD=90
# AUTO_ISOLATION_ENABLED=false
# AUTO_ISOLATION_THRESHOLD=90
# MONITOR_PROTECTED_CONTAINERS=postgres,selfsentry-backend
# MONITOR_RESPONSE_MAX_AGE_SECONDS=120
# MONITOR_RULE_CANDIDATES_ENABLED=false
# MONITOR_BENIGN_LOG_PATH=/absolute/path/to/operator-validated-benign-log.jsonl

# --- Optional advisory AI (existing Groq-compatible provider) ---
# GROQ_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b

# --- Host lifecycle and deterministic completion ---
# The database must be configured for managed startup, for example:
# DATABASE_URL=postgresql://selfsentry:<your-password>@localhost:5432/selfsentry_db
# FALCO_SERVICE=falco-modern-bpf
# FALCO_CONFIG_PATH=/etc/falco/falco.yaml
# Permanent duplicate registry; all backend workers/deployer must share this path.
# Default: <repository>/state/rule-guard. Back it up; do not clear it on restart.
# RULE_GUARD_STATE_DIR=/var/lib/selfsentry/rule-guard
# SELFSENTRY_STATE_DIR=/absolute/path/to/selfsentry/state
# AUTO_CONFIRM_ANOMALY_ENABLED=true
# AUTO_CONFIRM_ANOMALY_THRESHOLD=0.95
# Optional AI keys are not needed for primary explanations or suggested fixes.

# Explicit human-requested native retirement; keep disabled in ordinary operation.
# Recorded disposable acceptance does not authorize enabling it on another host.
SELFSENTRY_NATIVE_RETIREMENT_ENABLED=false
# Falco 0.45 protected reload_control Unix socket; this does not enable it in Falco.
FALCO_RELOAD_SOCKET=/run/falco/control.sock
